# Example environment configuration for Observe integration
# Copy this file to .env and update with your actual Observe credentials

# Observe OTLP Endpoint
# Replace with your actual Observe OTLP endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-tenant.observeinc.com:443

# Observe Authentication Headers
# Replace with your actual Observe token
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your-observe-token-here

# Service Configuration
OTEL_SERVICE_NAME=jmale
OTEL_SERVICE_VERSION=1.0-SNAPSHOT

# Resource Attributes
OTEL_RESOURCE_ATTRIBUTES=service.name=jmale,service.version=1.0-SNAPSHOT,deployment.environment=production

# Sampling Configuration (adjust as needed)
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# Batch Configuration (optimize for your use case)
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_EXPORT_TIMEOUT=30s
OTEL_BSP_SCHEDULE_DELAY=5s

# Metrics Configuration
OTEL_METRIC_EXPORT_INTERVAL=30s

# Development/Debug Settings
DEBUG_LOGGING=false
DEBUG_METRICS=false
DEBUG_TRACES=false

# Application-specific settings
HEALTH_CHECK_ENABLED=true
PERFORMANCE_MONITORING_ENABLED=true
